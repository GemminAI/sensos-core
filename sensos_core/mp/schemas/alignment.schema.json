{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:gmm:sensos:mp:alignment:0.1",
  "title": "sensos.mp.alignment/0.1 payload (carried in a HEXT v2 annotation)",
  "type": "object",
  "additionalProperties": false,
  "required": ["profile", "target", "readback", "aligner", "inputs_sha256", "rule_sha256", "results", "verification_status"],
  "properties": {
    "profile": { "const": "sensos.mp.alignment/0.1" },
    "target": { "$ref": "#/$defs/ref" },
    "readback": { "$ref": "#/$defs/ref" },
    "aligner": {
      "type": "object", "additionalProperties": false, "required": ["kind", "ref", "version"],
      "properties": {
        "kind": { "enum": ["rule", "llm", "human"] },
        "ref": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      }
    },
    "inputs_sha256": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/sha256" } },
    "rule_sha256": { "$ref": "#/$defs/sha256" },
    "results": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false, "required": ["ref", "status"],
        "properties": {
          "ref": { "type": ["string", "null"], "minLength": 1 },
          "status": { "enum": ["preserved", "lost", "added", "conflict", "missing_candidate"] }
        }
      }
    },
    "verification_status": { "enum": ["unverified", "verified", "rejected"] }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "ref": {
      "type": "object", "additionalProperties": false, "required": ["id", "state_hash"],
      "properties": { "id": { "type": "string", "minLength": 1 }, "state_hash": { "$ref": "#/$defs/sha256" } }
    }
  }
}
